#!/usr/bin/env bash
# Blocks direct pushes to main until server-side GitHub branch protection is available.
# Runs the source-aware secret scan before any push. Set CLARIQ_SKIP_SECRET_SCAN=1
# only for an investigated scanner false positive; it never bypasses the main guard.
if [[ "${CLARIQ_SKIP_SECRET_SCAN:-}" != "1" ]]; then
  repo_root=$(git rev-parse --show-toplevel)
  bash "$repo_root/scripts/scan_secrets.sh"
fi

if [[ "${CLARIQ_ALLOW_MAIN_PUSH:-}" == "1" ]]; then
  exit 0
fi

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "${remote_ref}" == "refs/heads/main" ]]; then
    cat >&2 <<'EOF'
Direct pushes to main are temporarily blocked by Clariq's local Git hook.
Push a feature branch and merge through a reviewed pull request instead.

For a documented, exceptional break-glass push only:
  CLARIQ_ALLOW_MAIN_PUSH=1 git push <remote> <refspec>
EOF
    exit 1
  fi
done
